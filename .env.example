# 공공데이터포털 디코딩 키 (인코딩 키 아님)
SERVICE_KEY=

# docker-compose의 db 컨테이너 비밀번호
POSTGRES_PASSWORD=

# ETL 접속 문자열. 비우면 libpq 환경변수(PGHOST 등)를 따른다.
DATABASE_URL=postgresql://apartment:<POSTGRES_PASSWORD>@127.0.0.1:5432/apartment

# MCP 서버 전용 읽기 전용 계정(apartment_reader 멤버). 서버는 이 값만 쓰고 DATABASE_URL로 넘어가지 않는다
MCP_DATABASE_URL=postgresql://apartment_mcp:<비밀번호>@127.0.0.1:5432/apartment

# MCP 서버 HTTP 인증 토큰(32자 이상). claude.ai 커넥터 요청 헤더 'Authorization: Bearer <이 값>'
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=
